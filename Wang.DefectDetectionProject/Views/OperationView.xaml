<UserControl x:Class="Wang.DefectDetectionProject.Views.OperationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:Wang.DefectDetectionProject.Shared.Controls;assembly=Wang.DefectDetectionProject.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <TabControl Grid.Row="1" x:Name="MainTabControl" Loaded="MainTabControl_Loaded">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding TabSelectionChangedCommand}" 
                                           CommandParameter="{Binding SelectedItem, ElementName=MainTabControl}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <TabItem Header="{DynamicResource ImageProcessing}" Tag="ImageProcessView">
                <md:DialogHost>
                    <!-- Content属性的绑定方法是元素绑定(Binding ElementName=...)的方法，指定要绑定的控件名和属性名以及绑定模式。 -->
                    <md:DrawerHost Content="{Binding ElementName=TabContentControl, Path=Content, Mode=TwoWay}">
                    </md:DrawerHost>
                </md:DialogHost>
            </TabItem>

            <TabItem Header="{DynamicResource DefectDetection}" Tag="DefectDetectionView">
                <md:DialogHost>
                    <!-- Content属性的绑定方法是元素绑定(Binding ElementName=...)的方法，指定要绑定的控件名和属性名以及绑定模式。 -->
                    <md:DrawerHost Content="{Binding ElementName=TabContentControl, Path=Content, Mode=TwoWay}">
                    </md:DrawerHost>
                </md:DialogHost>
            </TabItem>
        </TabControl>

        <ContentControl prism:RegionManager.RegionName="TabRegion" Name="TabContentControl" Visibility="Collapsed"/>
    </Grid>
</UserControl>
