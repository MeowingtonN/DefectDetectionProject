<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
                    xmlns:local="clr-namespace:Wang.DefectDetectionProject.Shared.Controls">

    <!-- ========== Material 主题色 ========== -->
    <Color x:Key="MaterialPrimaryColor">#6200EE</Color>
    <Color x:Key="MaterialPrimaryVariantColor">#3700B3</Color>
    <Color x:Key="MaterialSecondaryColor">#03DAC6</Color>
    <Color x:Key="MaterialSurfaceColor">#FFFFFF</Color>
    <Color x:Key="MaterialOnSurfaceColor">#1F000000</Color>
    <Color x:Key="MaterialOnSurfaceMediumColor">#99000000</Color>
    <Color x:Key="MaterialHoverOverlayColor">#0A000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource MaterialPrimaryColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource MaterialSurfaceColor}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource MaterialOnSurfaceMediumColor}"/>

    <!-- ========== TabControl 样式（MaterialDesign同款TabControl样式） ========== -->
    <Style x:Key="MaterialDesignTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="Transparent" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TabPanel IsItemsHost="True" Margin="0,0,0,-1" 
                                          KeyboardNavigation.TabIndex="1" 
                                          Background="Transparent"/>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="0,1,0,0" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="SelectedContent" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== TabItem 基础样式 ========== -->
    <Style x:Key="MaterialDesignTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinWidth" Value="90"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="HoverBorder" Grid.Row="0" Background="Transparent"/>
                        <ContentPresenter x:Name="HeaderContent" Grid.Row="0"
                                          Content="{TemplateBinding Header}"
                                          ContentSource="Header"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                        <Border x:Name="Indicator" Grid.Row="1" 
                                Height="3" 
                                Background="{DynamicResource PrimaryHueMidBrush}"
                                HorizontalAlignment="Stretch"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 默认 TabControl / TabItem 样式 ========== -->
    <Style TargetType="TabControl" BasedOn="{StaticResource MaterialDesignTabControl}"/>

    <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
        <!-- 将附加属性默认值绑定到 MaterialDesign 主题内部提供的动态画笔资源 PrimaryHueMidBrush。 -->
        <!-- 为什么需要自定义附加属性（比如代码里的 TabItemHelper）？
                这里的 TabItem 本身没有 SelectedIndicatorBrush 和 SelectedForeground 属性，但又想让每个 TabItem 能单独设置选中时的指示器颜色和文字颜色。这时候就可以：
                1. 建一个辅助类（比如 TabItemHelper）；
                2. 在里面用 DependencyProperty.RegisterAttached 声明附加属性；
                3. 在 XAML 里通过 local:TabItemHelper.SelectedIndicatorBrush 给 TabItem 设置这个额外属性；
                4. 在控件模板里通过 Binding 读这个属性的值，用来改变颜色。 -->
        <Setter Property="local:TabItemHelper.SelectedIndicatorBrush" 
            Value="{DynamicResource PrimaryHueMidBrush}"/>
        <Setter Property="local:TabItemHelper.SelectedForeground" 
            Value="{DynamicResource PrimaryHueMidBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 悬停层 -->
                        <Border x:Name="HoverBorder" Grid.Row="0" Background="Transparent"/>

                        <!-- 头部文字：默认未选中颜色 -->
                        <ContentPresenter x:Name="HeaderContent" Grid.Row="0"
                                          Content="{TemplateBinding Header}"
                                          ContentSource="Header"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{DynamicResource MaterialDesignBody}"/>

                        <!-- 下划线指示器：背景绑定到附加属性，FallbackValue改为直接颜色字符串 -->
                        <Border x:Name="Indicator" Grid.Row="1" Height="3"
                                HorizontalAlignment="Stretch"
                                RenderTransformOrigin="0,0.5">
                            <Border.Background>
                                <!-- 适用于更复杂的绑定设置 -->
                                <Binding Path="(local:TabItemHelper.SelectedIndicatorBrush)"
                                         RelativeSource="{RelativeSource TemplatedParent}"
                                         FallbackValue="#6200EE" />
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="Selected" GeneratedDuration="0:0:0.3">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition From="Selected" GeneratedDuration="0:0:0.2">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseIn"/>
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unselected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 禁用状态半透明 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>

                        <!-- 选中时字体颜色与下划线一致（FallbackValue也改为直接字符串） -->
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="HeaderContent" Property="TextElement.Foreground">
                                <Setter.Value>
                                    <Binding Path="(local:TabItemHelper.SelectedIndicatorBrush)"
                                             RelativeSource="{RelativeSource TemplatedParent}"
                                             FallbackValue="#6200EE" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>