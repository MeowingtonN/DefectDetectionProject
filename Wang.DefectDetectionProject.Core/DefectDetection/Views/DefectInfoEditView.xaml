<Window x:Class="Wang.DefectDetectionProject.Core.DefectDetection.Views.DefectInfoEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Wang.DefectDetectionProject.Core.DefectDetection.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="{DynamicResource DefectInfoEditWindow}" Height="450" Width="800">
    <Grid Margin="10">
        <!-- 字段列表（可编辑表格） -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{DynamicResource AddDefect}" Command="{Binding AddDefectCommand}" Width="200"/>
                <Button Content="{DynamicResource DeleteDefect}" Command="{Binding DeleteDefectCommand}" Width="200" Margin="10,0,0,0" Background="OrangeRed" BorderBrush="OrangeRed"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" 
                HorizontalAlignment="Right" 
                Orientation="Horizontal" 
                Margin="0,8,0,0">
                <Button Content="{DynamicResource ImportFromExcel}" 
                Command="{Binding ImportFromExcelCommand}" 
                Width="160" Margin="0,0,10,0"
                Style="{StaticResource MaterialDesignRaisedButton}"/>
                <Button Content="{DynamicResource ExportExcel}" 
                Command="{Binding ExportExcelCommand}" 
                Width="160"
                Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding DefectInfoCollection}"
                  SelectedItem="{Binding SelectedDefectInfo, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="True"
                  HeadersVisibility="All">
                <DataGrid.RowHeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="" Width="30"/>
                    </DataTemplate>
                </DataGrid.RowHeaderTemplate>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource DefectName}" Binding="{Binding ClassName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="*">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="2,0"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource DefectID}" Binding="{Binding ClassID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="*">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="2,0"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
